[Unit]
Description=VPN Node Agent
Documentation=https://github.com/your-account/VPN_NODE_AGENT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=vpn-agent
Group=vpn-agent

WorkingDirectory=/opt/vpn-node-agent
EnvironmentFile=/etc/vpn-node-agent/agent.env

ExecStart=/usr/bin/node /opt/vpn-node-agent/dist/index.js

Restart=always
RestartSec=5

TimeoutStartSec=30
TimeoutStopSec=20

KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target